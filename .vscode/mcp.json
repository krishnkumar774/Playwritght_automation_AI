{
	"servers": {
		"playwright": {
			"command": "npx",
			"args": [
				"@playwright/mcp@latest"
			],
			"type": "stdio"
		},
		"playwright-test": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"playwright",
				"run-test-mcp-server"
			]
		}
	},
	"inputs": [
		{
			"id": "serverName",
			"type": "promptString",
			"description": "Server Name"
		},
		{
			"id": "watchFiles",
			"type": "promptString",
			"description": "Watch Files"
		}
	]
}